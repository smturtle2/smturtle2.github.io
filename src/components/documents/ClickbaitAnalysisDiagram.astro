---
interface Props { locale: 'ko' | 'en'; }
const { locale } = Astro.props;
const en = locale === 'en';
---
<div class="diagram-viewport">
  <svg viewBox="-0.5 0 171 65" role="img" aria-label={en ? 'Article inputs pass through jamo FastText and a Transformer. The Transformer returns probability and attention; attention rollout selects sentences. The article body and selected sentences feed GPT commentary. Probability, selected sentences, and commentary appear in the article UI.' : '기사 입력을 자모 FastText와 Transformer로 처리해 확률과 attention을 얻고, rollout으로 주요 문장을 선정한다. 본문과 주요 문장을 입력받은 GPT 해설은 확률·문장 강조와 함께 기사 화면에 표시된다.'}>
    <defs><marker id="analysis-arrow" viewBox="0 0 8 8" refX="7.2" refY="4" markerUnits="userSpaceOnUse" markerWidth="1.9" markerHeight="1.9" orient="auto"><path d="M0,0 L8,4 L0,8 z" class="arrow-head" /></marker></defs>
    <rect class="box" x="0" y="21" width="28" height="16" rx="0.8" />
    <rect class="box accent" x="34" y="21" width="30" height="16" rx="0.8" />
    <rect class="box accent" x="70" y="21" width="32" height="16" rx="0.8" />
    <rect class="box" x="111" y="1" width="31" height="13" rx="0.8" />
    <rect class="box accent" x="111" y="18" width="31" height="13" rx="0.8" />
    <rect class="box" x="111" y="35" width="31" height="13" rx="0.8" />
    <rect class="box" x="70" y="50" width="32" height="13" rx="0.8" />
    <rect class="box accent" x="151" y="16" width="19" height="32" rx="0.8" />

    <path class="arrow" marker-end="url(#analysis-arrow)" d="M28,29 H33.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M64,29 H69.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M102,25 H106 V7.5 H110.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M102,29 H106 V24.5 H110.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M126.5,31 V34.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M142,7.5 H160.5 V15.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M142,41.5 H146.5 V34 H150.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M111,41.5 H106 V54.5 H102.4" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M14,37 V56.5 H69.6" />
    <path class="arrow" marker-end="url(#analysis-arrow)" d="M102,60 H148.5 V44 H150.6" />

    <text class="label" x="2.4" y="27.1">{en ? 'Article input' : '기사 입력'}</text>
    <text class="detail" x="2.4" y="33.6">{en ? 'Title / body' : '제목·부제·본문'}</text>
    <text class="label" x="36.4" y="27.1">{en ? 'Jamo FastText' : '자모 FastText'}</text>
    <text class="detail" x="36.4" y="33.6">{en ? 'Embeddings' : '단어 임베딩'}</text>
    <text class="label" x="72.4" y="27.1">Transformer</text>
    <text class="detail" x="72.4" y="33.6">{en ? 'Classify / attend' : '분류·attention'}</text>
    <text class="label" x="113.4" y="6.3">{en ? 'Probability' : '낚시성 확률'}</text>
    <text class="detail" x="113.4" y="11.3">{en ? '[CLS] output' : '[CLS] 출력'}</text>
    <text class="label" x="113.4" y="23.3">attention rollout</text>
    <text class="detail" x="113.4" y="28.3">{en ? 'Layer attention' : '층별 attention'}</text>
    <text class="label" x="113.4" y="40.3">{en ? 'Key sentences' : '주요 문장'}</text>
    <text class="detail" x="113.4" y="45.3">{en ? 'Token → sentence' : '토큰 점수로 선정'}</text>
    <text class="detail" x="37" y="54.2">{en ? 'Article body' : '기사 본문'}</text>
    <text class="label" x="72.4" y="55.3">{en ? 'GPT commentary' : 'GPT 해설'}</text>
    <text class="detail" x="72.4" y="60.3">{en ? 'Body + sentences' : '본문·주요 문장'}</text>
    <text class="label" x="153.4" y="23.5">{en ? 'Article UI' : '기사 화면'}</text>
    <text class="detail" x="153.4" y="30.5">{en ? 'Score' : '확률'}</text>
    <text class="detail" x="153.4" y="37.2">{en ? 'Highlights' : '문장 강조'}</text>
    <text class="detail" x="153.4" y="43.9">{en ? 'Commentary' : 'GPT 해설'}</text>
  </svg>
</div>
