---
import PairedBlock from './PairedBlock.astro';
import DocumentChildren from './DocumentChildren.astro';
import type { Locale } from '../../i18n';
import type { PairedDocument } from '../../documents/core/pairing';
interface Props { document: PairedDocument; locale: Locale; }
const { document, locale } = Astro.props;
---
<div class="sheet">
  <PairedBlock id={document.id + '/header'} documentHeaders={document.headers} locale={locale} sectionEnd />
  <DocumentChildren children={document.children} locale={locale} level={2} path={[document.id]} />
</div>
