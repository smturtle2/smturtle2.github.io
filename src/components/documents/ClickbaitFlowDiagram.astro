---
interface Props { locale: 'ko' | 'en'; }
const { locale } = Astro.props;
const en = locale === 'en';
---
<div class="diagram-viewport">
  <svg viewBox="-0.5 -5 171 29" role="img" aria-label={en ? 'Request and response path: extension, Spring Boot, request helper, and a persistent Python model process' : '요청과 응답 경로: 확장 프로그램, Spring Boot, 요청 헬퍼, 모델이 상주하는 Python 프로세스'}>
    <defs><marker id="service-arrow" viewBox="0 0 8 8" refX="7.2" refY="4" markerUnits="userSpaceOnUse" markerWidth="1.8" markerHeight="1.8" orient="auto-start-reverse"><path d="M0,0 L8,4 L0,8 z" class="arrow-head" /></marker></defs>
    <rect class="box accent" x="0" y="3" width="36" height="19" rx="0.8" />
    <rect class="box" x="45" y="3" width="36" height="19" rx="0.8" />
    <rect class="box accent" x="90" y="3" width="36" height="19" rx="0.8" />
    <rect class="box accent" x="135" y="3" width="35" height="19" rx="0.8" />
    <path class="arrow" marker-start="url(#service-arrow)" marker-end="url(#service-arrow)" d="M36.5,12 H44.5" />
    <path class="arrow" marker-start="url(#service-arrow)" marker-end="url(#service-arrow)" d="M81.5,12 H89.5" />
    <path class="arrow" marker-start="url(#service-arrow)" marker-end="url(#service-arrow)" d="M126.5,12 H134.5" />
    <text class="detail" x="40.5" y="0.5" text-anchor="middle">HTTP</text>
    <text class="detail" x="85.5" y="0.5" text-anchor="middle">{en ? 'Process I/O' : '실행·결과'}</text>
    <text class="detail" x="130.5" y="0.5" text-anchor="middle">{en ? 'Unix socket' : 'Unix 소켓'}</text>
    <text class="label" x="2.5" y="10">{en ? 'Chrome extension' : '확장 프로그램'}</text>
    <text class="detail" x="2.5" y="16.5">{en ? 'Request / display' : '분석 요청·결과 표시'}</text>
    <text class="label" x="47.5" y="10">Spring Boot</text>
    <text class="detail" x="47.5" y="16.5">{en ? 'Article / GPT' : '기사 처리·GPT 요청'}</text>
    <text class="label" x="92.5" y="10">{en ? 'Request helper' : 'Python 요청 헬퍼'}</text>
    <text class="detail" x="92.5" y="16.5">{en ? 'Runs per request' : '요청마다 실행'}</text>
    <text class="label" x="137.5" y="10">{en ? 'Python inference' : 'Python 추론'}</text>
    <text class="detail" x="137.5" y="16.5">{en ? 'Model stays loaded' : '모델을 불러 유지'}</text>
  </svg>
</div>
