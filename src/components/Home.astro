---
import SiteLayout from '../layouts/SiteLayout.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { type Locale, messages, localePath } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
}

interface Destination {
  href: string;
  title: string;
  description: string;
}

interface Contact {
  label: string;
  href: string;
}

const { locale } = Astro.props;
const t = messages[locale];
const name = profile.names[locale];

const destinations = [
  { href: localePath(locale, 'resume'), title: t.resumeTitle, description: t.resumeDescription },
  { href: localePath(locale, 'portfolio'), title: t.portfolioTitle, description: t.portfolioDescription },
] satisfies readonly Destination[];

const contacts = [
  { label: t.email, href: `mailto:${profile.email}` },
  { label: 'GitHub', href: profile.github },
  { label: 'Hugging Face', href: profile.huggingface },
] satisfies readonly Contact[];
---

<SiteLayout
  locale={locale}
  page="home"
  title={`${name} · ${profile.role}`}
  description={t.description(name)}
>
  <main class="home">
    <header class="identity">
      <h1 class="name">{name}</h1>
      <p class="role">{profile.role}</p>
      <LanguageSwitch locale={locale} page="home" />
    </header>

    <nav class="documents" aria-label={t.documents}>
      <ul role="list">
        {destinations.map(({ href, title, description }) => (
          <li>
            <a class="document" href={href}>
              <span class="document-title">{title}</span>
              <span class="document-description">{description}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <address class="contacts">
      <ul role="list">
        {contacts.map(({ label, href }) => (
          <li><a href={href} rel="me">{label}</a></li>
        ))}
      </ul>
    </address>
  </main>
</SiteLayout>

<style>
  .home {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    padding: 56px 20px 64px;
  }

  /* Identity: name and language switch share the first line, role below */
  .identity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'name switch'
      'role role';
    align-items: center;
    column-gap: 12px;
  }

  .identity :global(.language-switch) {
    grid-area: switch;
  }

  .name {
    grid-area: name;
    font-size: clamp(22px, 7vw, 26px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  /* Uppercase Latin needs a little air that Hangul does not */
  .name:lang(en) {
    letter-spacing: 0.01em;
  }

  .role {
    grid-area: role;
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* Documents: a short table of contents */
  .documents {
    margin-top: 40px;
  }

  .documents ul {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .documents li {
    border-bottom: 1px solid var(--color-rule);
  }

  .document {
    display: grid;
    row-gap: 2px;
    padding: 14px 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .document-title {
    font-size: 18px;
    line-height: 1.5;
  }

  .document-description {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (hover: hover) {
    .document:hover .document-title {
      color: var(--color-accent);
      text-decoration: underline;
    }
  }

  .document:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .document:focus-visible .document-title {
    color: var(--color-accent);
  }

  /* Contacts */
  .contacts {
    margin-top: 32px;
    font-style: normal;
  }

  .contacts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.6;
  }

  .contacts a {
    color: var(--color-sub);
    text-decoration-color: var(--color-muted);
  }

  .contacts a:hover,
  .contacts a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .contacts a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (min-width: 640px) {
    .home {
      padding-top: clamp(72px, 14vh, 128px);
    }

    /* Title and description share a line; descriptions align in one column */
    .document {
      grid-template-columns: 7rem minmax(0, 1fr);
      align-items: baseline;
      column-gap: 16px;
      padding-block: 16px;
    }
  }
</style>
