---
import SiteLayout from '../layouts/SiteLayout.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { profile } from '../data/profile';
---

<SiteLayout
  locale="ko"
  title={`${profile.names.ko} · ${profile.names.en}`}
  description="신동주의 이력서와 포트폴리오. Resume and portfolio of SHIN DONGJU."
  path="/"
>
  <main class="entry">
    <header class="identity">
      <h1>{profile.names.ko}</h1>
      <LanguageSwitch />
      <p>{profile.role}</p>
    </header>
  </main>
</SiteLayout>

<script>
  import '../scripts/entry-language';
</script>

<style>
  .entry {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    padding: 56px 20px 64px;
  }

  .identity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 12px;
  }

  h1 {
    font-size: clamp(22px, 7vw, 26px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  p {
    grid-column: 1 / -1;
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (min-width: 640px) {
    .entry {
      padding-top: clamp(72px, 14vh, 128px);
    }
  }
</style>
