---
import DocumentLayout from '../../layouts/DocumentLayout.astro';
---

<DocumentLayout locale="en" page="resume" title="SHIN DONGJU Resume" description="SHIN DONGJU's education, machine learning projects, and technical skills.">
  <article class="sheet resume-sheet">
    <header class="resume-header">
      <h1>SHIN DONGJU</h1>
      <p class="position">Machine Learning Engineer</p>
      <p class="contacts">
        <a href="mailto:smturtle2@kakao.com">smturtle2@kakao.com</a>
        <a href="https://github.com/smturtle2">github.com/smturtle2</a>
        <a href="https://huggingface.co/Hermanni">huggingface.co/Hermanni</a>
      </p>
    </header>

    <section class="resume-section education" aria-label="Education">
      <h2>Education</h2>
      <article class="entry">
        <div class="row"><h3><span class="entry-title">Dongguk University</span></h3><p class="date">Mar 2020 – Aug 2026 · Graduated</p></div>
        <div class="row meta"><p>Division of AI Software Convergence · Multimedia Software Engineering</p><p>GPA 4.14 / 4.5</p></div>
      </article>
